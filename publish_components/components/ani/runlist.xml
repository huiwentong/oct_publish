<?xml version="1.0" encoding="utf-8"?>
<!--
    迁移自老 publish_tool/depts/mk2/ani。
    Daily -> Dailies；Downstream / Downstream 2 -> Publish。
    Submit 与 Publish 均运行所有检查和发布项，旧 allow_skip 全部改为硬性阻断。
    generic_check 合并 Maya / 单位 / unknown_plugins / unlock_default_nodes。
    version_up_going 在 version_name 前执行，避免修复后发布路径仍使用旧版本号。
    两次 hierarchy / save_scene 保留旧流程顺序；blk/ani 使用 export_shot_usd_ani。
-->
<root>
    <checkcontainer>
        <check_group name="Dailies">
            <check type="gen" name="check_dcc_rv"/>
            <check type="maya_gen" name="version_up_going"/>
            <check type="gen" name="version_name"/>
            <check type="gen" name="check_selected_preview"/>
            <check type="gen" name="check_status"/>
            <check type="gen" name="check_publish_root"/>
        </check_group>
        <check_group name="Publish">
            <check type="maya_gen" name="generic_check"/>
            <check type="maya_shot" name="check_picked_file_is_current"/>
            <check type="maya_gen" name="check_work_file"/>
            <check type="maya_shot" name="check_shot_hierarchy"/>
            <check type="maya_shot" name="check_cam_grp"/>
            <check type="maya_shot" name="check_mov_range"/>
            <check type="maya_shot" name="check_start_frame"/>
            <check type="maya_shot" name="check_camera_name"/>
            <check type="maya_shot" name="check_camera_attrs"/>
            <check type="maya_shot" name="check_temp_usd_cache"/>
            <check type="maya_shot" name="check_split_task_comps"/>
            <check type="maya_shot" name="check_nemo_rig"/>
            <check type="maya_shot" name="check_stage_arch_is_new"/>
            <check type="maya_shot" name="check_stage_file_path"/>
            <check type="maya_shot" name="check_stage_dirty"/>
            <check type="ani" name="check_tpose"/>
            <check type="maya_shot" name="check_file_frame_range"/>
            <check type="maya_shot" name="check_shot_hierarchy"/>
            <check type="maya_shot" name="check_resources"/>
            <check type="maya_shot" name="check_ref_path"/>
            <check type="maya_shot" name="check_omit_asset"/>
            <check type="maya_shot" name="check_asset_version"/>
            <check type="maya_shot" name="check_usd_hierarchy"/>
            <check type="maya_shot" name="check_usd_namespace"/>
            <check type="maya_shot" name="check_sg_component"/>
            <check type="maya_shot" name="check_abnormal_dag_under_comp"/>
            <check type="maya_gen" name="check_display_layers"/>
            <check type="ani" name="check_duplicated_nodes"/>
        </check_group>
    </checkcontainer>
    <processcontainer>
        <process type="maya_gen" name="clean_scene" mode="Publish"/>
        <process type="maya_shot" name="clean_ani_scene" mode="Publish"/>
        <process type="gen" name="create_v_dir" mode="Dailies"/>
        <process type="maya_shot" name="copy_resources_to_v_dir" mode="Publish"/>
        <process type="maya_shot" name="collect_basic_comp_data" mode="Publish"/>
        <process type="maya_gen" name="save_scene" mode="Publish"/>
        <process type="gen" name="copy_work_file_to_v_dir" mode="Publish"/>
        <process type="maya_shot" name="copy_usd_file_to_v_dir" mode="Publish"/>
        <process type="gen" name="copy_preview_to_v_dir" mode="Dailies"/>
        <process type="maya_shot" name="edit_ma_file" mode="Publish"/>
        <process type="maya_shot" name="export_comp_data" mode="Publish"/>
        <process type="maya_shot" name="restore_resource_path" mode="Publish"/>
        <process type="maya_gen" name="save_scene" mode="Publish"/>
        <process type="gen" name="sym_link_no_num_version" mode="Publish"/>
        <process type="gen" name="lock_v_dir" mode="Dailies"/>
        <process type="gen" name="create_sg_version" mode="Dailies"/>
        <process type="ani" name="update_sg_version" mode="Dailies"/>
        <process type="maya_shot" name="update_sg_components" mode="Publish"/>
        <process type="maya_shot" name="sub_to_deadline_cache" mode="Publish"/>
        <process type="ani" name="sub_to_deadline_export_shot_usd" mode="Publish"/>
    </processcontainer>
</root>
