<?xml version="1.0"?>
<!--
    ASB 组装发布 —— mod 环节 + ASB 资产 + model 任务
    迁移自 depts/mk2/mod_asb 的 publish_checks.xml + publish_processes.xml

    老的 Daily / Downstream 两组对应新架构的 Dailies / Publish。

    专属组件通过 process_data 传递根组、USD 数据和 SG 关联清单。
-->
<root>

    <checkcontainer>
        <check_group name="Dailies">
            <check type="gen" name="check_dcc_rv"/>
            <!-- 版本递增修复会另存工作文件，必须先于 version_name 生成发布路径 -->
            <check type="maya_gen" name="version_up_going"/>
            <check type="gen" name="version_name"/>
            <check type="gen" name="check_selected_preview"/>
            <check type="gen" name="check_status"/>
            <check type="gen" name="check_publish_root"/>
        </check_group>

        <check_group name="Publish">
            <!-- 合并 this_is_maya + check_maya_unit + unknown_nodes + unknown_plugins + unlock_default_nodes -->
            <check type="maya_gen" name="generic_check"/>
            <!-- 合并 check_work_file + version_name_match -->
            <check type="maya_gen" name="check_work_file"/>
            <check type="asb_build" name="check_assets_hierarchy"/>
            <check type="asb_build" name="check_usd_dirty"/>
            <check type="asb_build" name="check_usd_relative_path"/>
        </check_group>
    </checkcontainer>

    <processcontainer>
        <process type="tex" name="save_scene" mode="Publish"/>
        <process type="gen" name="create_v_dir" mode="Dailies"/>
        <process type="gen" name="copy_preview_to_v_dir" mode="Dailies"/>
        <!-- ASB 收集场景内全部贴图，不按普通模型的 high/材质连接过滤 -->
        <process type="asb_build" name="copy_scene_images" mode="Publish"/>
        <process type="asb_build" name="collect_asb_comp_data" mode="Publish"/>
        <process type="asb_build" name="export_asset_ma" mode="Publish"/>
        <process type="asb_build" name="create_asb_usd" mode="Publish"/>
        <process type="gen" name="lock_v_dir" mode="Dailies"/>
        <process type="asb_build" name="update_sg_sub_asset" mode="Publish"/>
        <!-- 老 assembly/create_sg_version 拆成两步：通用建版本 + ASB 专属的 component 关联 -->
        <process type="gen" name="create_sg_version" mode="Dailies"/>
        <process type="asb_build" name="link_component_versions" mode="Publish"/>
        <process type="gen" name="sym_link_no_num_version" mode="Publish"/>
    </processcontainer>

</root>
