<?xml version="1.0"?>
<root>

    <checkcontainer>
        <check_group name="Dailies">
            <check type="gen" name="check_dcc_rv"/>
            <!-- 版本递增修复会另存工作文件，必须先于 version_name 生成发布路径 -->
            <check type="maya_gen" name="version_up_going"/>
            <check type="gen" name="version_name"/>
            <check type="gen" name="check_selected_preview"/>
            <check type="gen" name="check_status"/>
            <check type="gen" name="check_publish_root"/>
        </check_group>

        <check_group name="Publish">
            <!-- 数据种子：构建 gen_asset_data，Publish 的 4 个 process 全依赖它，三项顺序不能动 -->
            <check type="asb_split" name="check_assembly_all_hierarchy"/>
            <check type="asb_split" name="check_asb_split_marks"/>
            <check type="asb_split" name="check_asset_name_unique"/>
            <check type="maya_gen" name="generic_check"/>
            <!-- 表单里选的文件必须是当前打开的场景：检查看的是当前场景，用表单路径推工作目录 -->
            <check type="maya_shot" name="check_picked_file_is_current"/>
            <check type="maya_gen" name="check_work_file"/>
            <check type="maya_gen" name="check_frame_rate"/>
            <check type="maya_gen" name="no_name_space"/>
            <check type="mod" name="check_instanced_node"/>
            <check type="mod" name="one_geo_only"/>
            <check type="mod" name="unique_name"/>
            <check type="maya_gen" name="mesh_name"/>
            <check type="tex" name="check_illegal_path"/>
            <!-- 农场端打开 source.ma 不设 Maya 工程，贴图必须在工作目录下且为绝对路径 -->
            <check type="asb_split" name="check_textures_in_work_dir"/>
            <check type="asb_split" name="check_texture_format"/>
            <!-- 不用 tex/check_colorspace：它的白名单只有两个色彩空间，
                 ASB 场景引用的子资产贴图会被误判 -->
            <check type="asb_split" name="check_colorspace"/>
            <check type="mod" name="check_transform_channels"/>
            <check type="maya_gen" name="check_display_layers"/>
            <check type="mod" name="check_node_override"/>
            <check type="mod" name="assign_shaders"/>
        </check_group>
    </checkcontainer>

    <processcontainer>
        <process type="tex" name="save_scene" mode="Publish"/>
        <process type="gen" name="create_v_dir" mode="Dailies"/>
        <process type="gen" name="copy_preview_to_v_dir" mode="Dailies"/>
        <process type="maya_gen" name="clean_asset_scene" mode="Publish"/>
        <process type="asb_split" name="clean_asb_scene" mode="Publish"/>
        <process type="maya_gen" name="clean_scene" mode="Publish"/>
        <process type="asb_split" name="export_asb_source_scene" mode="Publish"/>
        <process type="asb_split" name="snapshot_each_object" mode="Publish"/>
        <process type="asb_split" name="create_sub_asset_and_record" mode="Publish"/>
        <process type="asb_split" name="gen_asb_deadline_job" mode="Publish"/>
        <process type="gen" name="lock_v_dir" mode="Dailies"/>
        <process type="gen" name="sym_link_no_num_version" mode="Publish"/>
        <process type="gen" name="create_sg_version" mode="Dailies"/>
        <process type="asb_split" name="submit_asb_deadline_task" mode="Publish"/>
    </processcontainer>

</root>
