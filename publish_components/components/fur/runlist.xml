        <process type="fur" name="export_guides_file" mode="Publish"/>
        <process type="fur" name="export_xgen_file" mode="Publish"/>
        <process type="fur" name="export_xgen_bound_geometry" mode="Publish"/>
        <process type="fur" name="export_wrap_file" mode="Publish"/>
