            <check type="gen" name="version_up_going"/>
            <check type="gen" name="check_selected_preview"/>
            <check type="gen" name="check_publish_root"/>
            <check type="gen" name="check_frame_rate"/>

        </check_group>

        <check_group name="Publish">

            <check type="maya_gen" name="check_hierarchy_main"/>
            <check type="fur" name="unknown_check"/>
            <check type="fur" name="unlock_default_nodes"/>
            <check type="fur" name="no_name_space"/>
