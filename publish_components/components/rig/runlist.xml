<?xml version="1.0"?>
<root>

<!-- from GongShuai
1. version_name_match 合并到 check_work_file
2. check_work_file 重构可以与version up going 里的 auto save 合并 （需要重构）
3. match_hierarchy 重构
4. mesh_name, check_empty_mesh, check_lamina_faces, nonmanifold_face, check_holes, extremely_short_edge 合并为 check_mesh
5. check_maya_unit, unknown_nodes, unknown_plugins, unlock_default_nodes 合并为 generic_check
-->

    <checkcontainer>
        <check_group name="Dailies">
            <check type="gen" name="check_dcc_rv"/>
            <check type="gen" name="version_name"/>
            <check type="gen" name="version_up_going"/>
            <check type="gen" name="check_selected_preview"/>
            <check type="gen" name="check_status"/>
            <check type="gen" name="check_publish_root"/>
        </check_group>

        <check_group name="Publish">
            <check type="maya_gen" name="check_work_file"/>
            <check type="maya_gen" name="generic_check"/>
            <check type="maya_gen" name="check_reference_node"/>
            <check type="maya_gen" name="check_hierarchy_main"/>
            <check type="rig" name="check_rig_hierarchy"/>
            <check type="maya_gen" name="check_non_unique_dag"/>
            <check type="maya_gen" name="no_name_space"/>
            <check type="mod" name="check_instanced_node"/>
            <check type="rig" name="io_mesh_name"/>
<!--            <check type="rig" name="check_mesh"/>-->
            <check type="maya_gen" name="mesh_name"/>
            <check type="maya_gen" name="match_hierarchy"/>
            <check type="maya_gen" name="check_mod_hierarchy_order"/>
            <check type="rig" name="check_ctrl_name"/>
            <check type="rig" name="check_inconsistent_movement"/>
            <check type="rig" name="check_control_values"/>
            <check type="maya_gen" name="check_display_layers"/>
            <check type="maya_gen" name="check_display_override"/>
            <check type="maya_gen" name="check_texture_path_locked"/>
            <check type="maya_gen" name="check_facesets"/>
            <check type="maya_gen" name="check_jnts_attrs"/>
        </check_group>
    </checkcontainer>

    <processcontainer>
    <process type="maya_gen" name="save_scene" mode="Publish"/>
    <process type="rig" name="unlock_dag_nodes" mode="Publish"/>
    <process type="maya_gen" name="clean_scene" mode="Publish"/>
    <process type="maya_gen" name="clean_asset_scene" mode="Publish"/>
    <process type="rig" name="cleanup_rig_file" mode="Publish"/>
    <process type="maya_gen" name="maya_version_attr" mode="Publish"/>
    <process type="gen" name="create_v_dir" mode="Dailies"/>
    <process type="gen" name="copy_preview_to_v_dir" mode="Dailies"/>
    <process type="maya_gen" name="copy_preview_imgs" mode="Dailies"/>
    <process type="maya_gen" name="copy_asset_images" mode="Publish"/>
    <process type="maya_gen" name="asset_mesh_xml" mode="Publish"/>
    <process type="rig" name="export_ctrl_info" mode="Publish"/>
	<process type="maya_gen" name="version_up" mode="Publish"/>
    <process type="maya_gen" name="export_asset_ma" mode="Publish"/>
	<process type="maya_gen" name="copy_dna" mode="Publish"/>
	<process type="maya_gen" name="export_cms" mode="Publish"/>
<!--导出abc、assembly，先取消-->
<!--    <process type="mod" name="export_asset_abc" mode="Publish"/>-->
<!--	<process type="mod" name="export_assembly" mode="Publish"/>-->
    <process type="rig" name="export_preview_data" mode="Publish"/>
	<process type="maya_gen" name="export_rig_fbx" mode="Publish"/>
	<process type="rig" name="export_rigging_usd" mode="Publish"/>
    <process type="gen" name="create_manifest_file" mode="Publish"/>
    <process type="gen" name="lock_v_dir" mode="Dailies"/>
    <process type="gen" name="create_sg_version" mode="Dailies"/>
<!--update_sg_version，感觉不需要-->
<!--    <process type="rig" name="update_sg_version" mode="Publish"/>-->
    <process type="gen" name="sym_link_no_num_version" mode="Publish"/>
    </processcontainer>

</root>