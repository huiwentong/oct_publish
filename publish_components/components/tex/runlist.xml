        <process type="gen" name="create_v_dir" mode="Dailies"/>
        <process type="tex" name="upload_local_textures" mode="Publish"/>
        <process type="tex" name="copy_texpreview_to_v_dir" mode="Dailies"/>
        <process type="tex" name="copy_texture_srcfile" mode="Publish"/>
        <process type="maya_gen" name="maya_version_attr" mode="Publish"/>
        <process type="maya_gen" name="asset_mesh_xml" mode="Publish"/>
